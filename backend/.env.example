# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String
MONGO_URI=mongodb://localhost:27017/qmetric

# JWT Secret Key (generate a strong random 64-character secret in production)
ACCESS_TOKEN_SECRET=your_jwt_secret_key_here

# Cloudflare Turnstile CAPTCHA Secret Key
# Use 1x0000000000000000000000000000000AA for local testing (always passes)
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Admin Secret Key for protecting administrative routes like /auth/bulk-register and /auth/create-admin
ADMIN_SECRET_KEY=replace-with-64-char-random-hex-string

# CSRF Secret for double submit cookie protection
CSRF_SECRET=replace-with-64-char-random-hex-string

# Cloudinary Configuration for Image Storage and OCR
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# ─── Email notifications (optional — silently no-ops if unset) ──
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# ─── Development Auth Bypass ─────────────────────────────────────────
# ⚠️  NEVER set this to 'true' in production. This completely bypasses
#     all authentication (CSRF, Turnstile, passwords). Only for local dev.
ENABLE_DEV_AUTH=false
SEED_DEMO_PASSWORD=QMetricDemo@123